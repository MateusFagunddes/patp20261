<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.PersonalController" stylesheets="@/view/styles/admin-dark.css" styleClass="page-root">
    <children>
        <Label text="Personais" styleClass="module-title">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <HBox styleClass="toolbar-row">
            <children>
                <HBox styleClass="toolbar-row" spacing="6.0">
                    <children>
                        <ComboBox prefWidth="70.0" styleClass="field-dark" promptText="10" />
                        <Label text="entries per page" styleClass="toolbar-label" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox styleClass="toolbar-row" spacing="8.0">
                    <children>
                        <Label text="Search:" styleClass="toolbar-label" />
                        <TextField fx:id="txtBusca" promptText="Buscar por nome ou email" prefWidth="250.0" styleClass="field-dark" />
                        <Button text="Pesquisar" onAction="#onPesquisar" styleClass="btn-primary" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <TableView fx:id="tblPersonais" prefHeight="420.0" prefWidth="780.0" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colNome" prefWidth="170.0" text="Nome" />
                <TableColumn fx:id="colEmail" prefWidth="190.0" text="Email" />
                <TableColumn fx:id="colCref" prefWidth="120.0" text="CREF" />
                <TableColumn fx:id="colEspecialidade" prefWidth="210.0" text="Especialidade" />
                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
            </columns>
        </TableView>

        <HBox styleClass="footer-row">
            <children>
                <Label fx:id="lblTotal" text="Showing 0 entries" styleClass="footer-info" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="&lt;" styleClass="btn-page" />
                <Button text="1" styleClass="btn-page-active" />
                <Button text="2" styleClass="btn-page" />
                <Button text="3" styleClass="btn-page" />
                <Button text=">" styleClass="btn-page" />
            </children>
        </HBox>
    </children>
</VBox>
