<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.login.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e1e2f, #2b2b40);">

    <children>

        <!-- Título -->
        <Label layoutX="185.0" layoutY="40.0"
               text="Bem-vindo ao GymPro">

            <font>
                <Font size="24.0"/>
            </font>

            <style>
                -fx-text-fill: white;
                -fx-font-weight: bold;
            </style>

        </Label>

        <!-- Subtítulo -->
        <Label layoutX="205.0" layoutY="75.0"
               text="Faça login para continuar"
               style="-fx-text-fill: #cfcfcf; -fx-font-size: 13px;" />

        <!-- Usuário -->
        <Text layoutX="170.0" layoutY="145.0"
              text="Usuário"
              style="-fx-fill: white; -fx-font-size: 14px;" />

        <TextField fx:id="txtUsuario"
                   layoutX="165.0"
                   layoutY="155.0"
                   prefHeight="38.0"
                   prefWidth="270.0"
                   promptText="Digite seu usuário"
                   style="
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-background-color: white;
                       -fx-padding: 0 10 0 10;
                   "/>

        <!-- Senha -->
        <Text layoutX="170.0" layoutY="225.0"
              text="Senha"
              style="-fx-fill: white; -fx-font-size: 14px;" />

        <PasswordField fx:id="txtSenha"
                       layoutX="165.0"
                       layoutY="235.0"
                       prefHeight="38.0"
                       prefWidth="270.0"
                       promptText="Digite sua senha"
                       style="
                           -fx-background-radius: 10;
                           -fx-border-radius: 10;
                           -fx-background-color: white;
                           -fx-padding: 0 10 0 10;
                       "/>

        <!-- Esqueci senha -->
        <Hyperlink layoutX="165.0"
                   layoutY="280.0"
                   text="Esqueci minha senha"
                   style="-fx-text-fill: #70a1ff;" />

        <!-- Botão entrar -->
        <Button fx:id="btnEntrar"
                layoutX="165.0"
                layoutY="325.0"
                mnemonicParsing="false"
            onAction="#onEntrar"
                prefHeight="40.0"
                prefWidth="120.0"
                text="Entrar"
                style="
                    -fx-background-color: #4CAF50;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 10;
                    -fx-cursor: hand;
                "/>

        <!-- Botão cadastrar -->
        <Button fx:id="btnCadastrar"
                layoutX="315.0"
                layoutY="325.0"
                managed="false"
                mnemonicParsing="false"
            onAction="#onCadastrar"
                prefHeight="40.0"
                prefWidth="120.0"
                text="Cadastrar"
                visible="false"
                style="
                    -fx-background-color: #2196F3;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 10;
                    -fx-cursor: hand;
                "/>

    </children>
</AnchorPane>