{
    "java.project.sourcePaths": [
        "gympro-admin/src"
    ],
    "java.project.outputPath": "gympro-admin/bin",
    "java.project.referencedLibraries": [
        "gympro-admin/lib/**/*.jar"
    ],
    "java.debug.settings.onBuildFailureProceed": true,
    "java.debug.settings.vmArgs": "--module-path gympro-admin/lib/javafx-sdk-21.0.4/lib --add-modules javafx.controls,javafx.fxml"
}